%table.table.align-middle.mb-0
  %tr
    %th= t("auth.credentials.list.name")
    %th= t("auth.credentials.list.registered")
    %th= t("auth.credentials.list.encryption")
    %th
  - @credentials.each do |cred|
    %tr{data: {"webauthn-target" => "credential"}, id: dom_id(cred)}
      %td= cred.label
      %td= datetime(cred.created_at)
      %td= cred.comment
      %td.text-end
        - if cred.deletable?
          - unless cred.type == "Auth::Credential::Webauthn" && @webauthn_cred_count == 1
            = v.delete_button url: auth.credential_path(cred), confirm: true, size: "sm", label: ""
        - if cred.editable?
          = v.link_button url: auth.edit_credential_path(cred), size: "sm", icon: "pencil", data: {turbo: false}

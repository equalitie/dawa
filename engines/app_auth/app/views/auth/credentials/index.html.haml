= breadcrumbs

.mb-4
  = v.card(header: t("auth.credentials.index.log_in")) do |card|
    - card.with_table do
      %turbo-frame#credentials-list
        = render "auth/credentials/list"
    .btn-toolbar
      = v.post_button(label: t("auth.credentials.index.add_passkey"), icon: "plus-lg", url: credentials_path, params: {type: "webauthn"})
      = v.post_button(label: t("auth.credentials.index.add_recovery"), icon: "plus-lg", url: credentials_path, params: {type: "recovery"})

.mb-4
  = v.card(header: t("auth.credentials.index.active_sessions")) do |card|
    - card.with_table do
      %table.table.table-sm
        %tr
          %th= t("auth.credentials.index.created")
          %th= t("auth.credentials.index.last_seen")
          %th= t("auth.credentials.index.credential")
          %th= t("auth.credentials.index.user_agent")
        - @sessions.each do |session|
          %tr
            %td= datetime session.created_at
            %td= datetime session.updated_at
            %td= session.attempt&.credential&.label
            %td= attempt_user_agent(session.attempt)

.mb-4
  = v.card(header: t("auth.credentials.index.auth_history")) do |card|
    - card.with_table do
      - v.paginate(top: false, html: {class: "card-footer"}) do
        %table.table.table-sm
          %tr
            %th= t("auth.credentials.index.when")
            %th
            %th= t("auth.credentials.index.credential")
            %th= t("auth.credentials.index.user_agent")
          - @attempts.each do |attempt|
            %tr
              %td= datetime attempt.created_at
              %td= attempt.is_success? ? t("auth.credentials.index.success") : t("auth.credentials.index.failure")
              %td= attempt.credential&.label
              %td= attempt_user_agent(attempt)

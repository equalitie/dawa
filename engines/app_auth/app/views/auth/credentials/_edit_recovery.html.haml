-#
-# This is the only chance that the user will have to see the generated recovery code.
-#
- recovery_code = @credential.generate

.mb-4
= t("auth.credentials.recovery_intro")

.mb-4
  = bootstrap_form_with(model: @credential, url: credential_path(@credential), method: "put") do |f|
    = hidden_field_tag "credential[encryption_phrase]", recovery_code
    .bg-light.rounded.p-5
      .font-monospace.fs-2.text-center
        = recovery_code
    .btn-toolbar.mt-4
      = f.v.delete_button(label: t("nav.cancel"), icon: "x-lg", url: credential_path(@credential), data: {turbo: false})
      = f.v.submit_button(label: t("nav.finish"), icon: "check-circle")

= auth_breadcrumbs do |bc|
  - bc.with_crumb { link_to t("auth.credentials.edit.authentication"), credentials_path }
  - bc.with_crumb { t("auth.credentials.edit.title") }

- if !@credential.registered?
  = render "edit_register_passkey"
- elsif @credential.is_recovery?
  = render "edit_recovery"
- elsif !@credential.encryption_is_setup?
  - if @credential.supports_prf?
    = render "edit_encryption_prf"
  - else
    = render "edit_encryption_phrase"
- else
  = render "form"

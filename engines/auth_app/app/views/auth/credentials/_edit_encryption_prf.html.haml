.mb-4
= t("auth.credentials.encryption_prf_intro")

.mb-4
  = v.controller("session", username: current_user.profile.username) do |c|
    = bootstrap_form_with(url: credential_path(@credential), method: "put") do |f|
      = hidden_field_tag :command, "finish"
      .middlebox.bg-light.rounded.p-5
        = enable_encryption_button(@credential, c)
        = encryption_enabled_button(@credential, c)
      .btn-toolbar.mt-4
        = f.v.delete_button(label: t("nav.cancel"), icon: "x-lg", url: credential_path(@credential), data: {turbo: false})
        = f.v.submit_button(label: t("nav.finish"), icon: "check-circle", disabled: true,
          hide: @credential.encryption?, data: c.target("hide_on_success"))
        = f.v.submit_button(label: t("nav.finish"), icon: "check-circle", disabled: false,
          hide: !@credential.encryption?, data: c.target("show_on_success"))

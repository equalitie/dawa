-# locals: (form:, error: nil)

.mb-4= t("auth.encryption_phrase_description")

-# this is an attempt to prevent the browser from saving the
-# encryption phrase. I am not sure it works
.d-none= password_field_tag :password

.bg-light.rounded.p-5.btn-white.mb-4
  = form.password_field :encryption_phrase,
    label: t("auth.encryption_phrase"),
    autocomplete: false,
    autofocus: true,
    class: (error ? "is-invalid" : "")
  - if error
    .always-visible.invalid-feedback= error

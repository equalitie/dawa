= bootstrap_form_with(model: @credential, url: credential_path(@credential), method: "put") do |f|
  = render "auth/credentials/phrase_form", form: f
  .btn-toolbar
    = f.v.delete_button(label: t("nav.cancel"), icon: "x-lg", url: credential_path(@credential), data: {turbo: false})
    = f.v.submit_button(label: t("nav.finish"), icon: "check-circle")

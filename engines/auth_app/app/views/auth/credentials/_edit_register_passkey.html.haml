-#
-# this is the first step in adding a new passkey,
-# where we register the passkey.
-#
.mb-4
  = v.controller("webauthn") do |c|
    = bootstrap_form_with(url: credential_path(@credential), method: "put") do |f|
      .middlebox.bg-light.rounded.p-5
        = add_passkey_button(@credential, c)
        = passkey_added_button(@credential, c)
      .btn-toolbar.mt-4
        = f.v.delete_button(label: t("nav.cancel"), icon: "x-lg", url: credential_path(@credential), data: {turbo: false})
        = f.v.link_button(label: t("nav.next"), icon: "chevron-right", disabled: true, data: c.target("hide_on_success"))
        = f.v.submit_button(label: t("nav.next"), icon: "chevron-right", hide: true, data: c.target("show_on_success"))

.mb-4= render "help/passkeys"

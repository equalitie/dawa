.git
.gitignore
.bundle
.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

log/*
tmp/*
tmp/pids/*

!/log/.keep
!/tmp/.keep
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
node_modules
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
.github
.gitlab

# Ignore development files
.devcontainer

# Ignore Docker-related files
.dockerignore
Dockerfile*

# more aggressive docker ignore:
storage
coverage
node_modules
spec
# match `test` at any depth (e.g. engines/*/test, not just the top-level test/)
**/test
*.md

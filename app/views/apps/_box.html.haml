-# locals: (app: nil, pending: nil, message: nil)
-#
  an info box for an app instance.

  this partial gets updated as the app instance state changes.

  Locals:

    app: nil       the AppInstance to describe. may be nil to show error only
    pending: nil   the command currently in flight ("start", "stop" or "restart"), which turns the
                   pressed button into a disabled spinner and disables the others. A display hint, NOT
                   a state: the badge keeps reporting what the backend last said, because
                   inventing "starting" as a status would claim something nobody has observed.
    message: nil   a reason the command was refused or failed, so the user can read it and try
                   again.
:ruby
  disabled_start_button   = v.button label: t("apps.status.start"), icon: "play-fill", disabled: true
  disabled_stop_button    = v.button label: t("apps.status.stop"), icon: "stop-fill", disabled: true
  disabled_restart_button = v.button label: t("apps.status.restart"), icon: "arrow-clockwise", disabled: true

= v.box(icon: "box-seam", size: "lg", id: "app-box") do |box|
  - if message.present?
    = v.alert("danger", icon: "x-circle") do
      %div= message
  - if app.present?
    .d-flex
      %h3.mb-0= link_to_app_domain(app)
      .ms-3
        = v.app_status_badge(app, pending: pending)

    - box.with_buttons do
      - if pending == "start"
        = v.button label: t("apps.status.start"), icon: "spinner", disabled: true
        = disabled_start_button
        = disabled_restart_button
      - elsif pending == "stop"
        = disabled_start_button
        = v.button label: t("apps.status.stop"), icon: "spinner", disabled: true
        = disabled_restart_button
      - elsif pending == "restart"
        = disabled_start_button
        = disabled_stop_button
        = v.button label: t("apps.status.restart"), icon: "spinner", disabled: true
      - elsif app.running?
        = disabled_start_button
        = v.update_button label: t("apps.status.stop"), icon: "stop-fill",
          data: { "stream-ready-target" => "button" },
          url: app_path(app.id), params: { command: "stop" }
        = v.update_button label: t("apps.status.restart"), icon: "arrow-clockwise",
          data: { "stream-ready-target" => "button" },
          url: app_path(app.id), params: { command: "restart" }
      - elsif app.stopped?
        = v.update_button label: t("apps.status.start"), icon: "play-fill",
          data: { "stream-ready-target" => "button" },
          url: app_path(app.id), params: { command: "start" }
        = disabled_stop_button
        = disabled_restart_button
      - else
        = disabled_start_button
        = disabled_stop_button
        = disabled_restart_button

      -#= v.link_button label: t("apps.uninstall.action"), icon: "trash",
        color: "danger", url: uninstall_app_path(app.id)

    %dl.row.small.mb-0.mt-3
      %dt.col-4.col-md-2.text-muted= t("apps.instance_id")
      %dd.col-8.col-md-10= app.id
      %dt.col-4.col-md-2.text-muted= t("apps.version")
      %dd.col-8.col-md-10
        - if app.version.present?
          = app.version
        - else
          %em.text-muted{data: {placeholder: "true"}}= t("apps.version_unknown")
      - if app.catalog_entry_id.present?
        %dt.col-4.col-md-2.text-muted= t("apps.app")
        %dd.col-8.col-md-10= app.catalog_entry_id

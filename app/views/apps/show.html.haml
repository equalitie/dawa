-# get up status updates
- if @app
  = turbo_stream_from @app.id

= breadcrumbs do |bc|
  - bc.with_crumb(active: true) { @app&.domain&.presence || params[:id] }

- if @error.present?
  = v.alert("danger", icon: "x-circle") do
    .mb-2.fw-bold= t("apps.catalog_unreachable")
    %div= @error

- else
  = v.controller("stream-ready") do
    = render "apps/box", app: @app
  = turbo_frame_tag("app-tabs") do
    = v.tab_bar do |tabs|
      - tabs.with_tab(label: t("jobs.title"), url: app_path(@app.id), active: params[:tab].nil?)
      - tabs.with_tab(label: t("metrics.title"), url: app_path(@app.id, tab: "metrics"), active: params[:tab] == "metrics")
      - tabs.with_tab(label: t("logs.title"), url: app_path(@app.id, tab: "logs"), active: params[:tab] == "logs")
    - if params[:tab].nil?
      = render "show_jobs"
    - elsif params[:tab] == "metrics"
      = render "show_metrics"
    - elsif params[:tab] == "logs"
      = render "show_logs"

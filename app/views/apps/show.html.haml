-# get up status updates
- if @app
  = turbo_stream_from @app.id

= breadcrumbs do |bc|
  - bc.with_crumb(active: true) { @app&.id || params[:id] }

- if @error.present?
  = v.alert("danger", icon: "x-circle") do
    .mb-2.fw-bold= t("apps.catalog_unreachable")
    %div= @error

- else
  = v.controller("stream-ready") do
    = render "apps/box", app: @app

  %h4= t("jobs.active")

  - if @active_jobs.any?
    = v.table(t("jobs.active")) do |t|
      - t.columns job_columns
      - @active_jobs.each do |job|
        = t.v.job_row(job, @app)
  - else
    = v.alert("info", icon: "info-circle") do
      %p= t("jobs.no_active")

  %h4= t("jobs.past")

  - if @past_jobs.any?
    = v.table(t("jobs.past")) do |t|
      - t.columns job_columns
      - @past_jobs.each do |job|
        = t.v.job_row(job, @app)
  - else
    = v.alert("info", icon: "info-circle") do
      %p= t("jobs.no_past")

= turbo_stream_from @container.id, id: "#{@container.id}-stream"

= breadcrumbs do |bc|
  - bc.with_crumb { d(@container).display_name }

= v.controller("stream-ready") do
  = render "containers/show/container_box", container: @container

= v.tab_bar do |tabs|
  - tabs.with_tab(label: t(".overview_tab"), url: container_path(@container.id), active: params[:tab].nil? || params[:tab] == "overview") do
    = render "containers/show/overview"
  - tabs.with_tab(label: t(".config_tab"), url: container_path(@container.id, tab: "config"), active: params[:tab] == "config") do
    - if @container.config
      = render "containers/show/config"
    - if @container.host_config
      = render "containers/show/host_config"
    - if @container.mounts&.any?
      = render "containers/show/mounts"
    - if @container.network_settings
      = render "containers/show/network"
  - tabs.with_tab(label: t(".logs_tab"), url: container_path(@container.id, tab: "logs"), active: params[:tab] == "logs")

- # the log content is rendered outside the tab bar component so we can control
- # all the nested classes.
- if params[:tab] == "logs"
  = render "containers/show/logs", container_id: @container.id

-# locals: (container: @container)
-# disable all buttons when pending actions
-# (note: starting and stopping are not real docker states, we just added those)
- disabled = ["starting", "stopping", "restarting"].include?(container.state.status)
= v.box(icon: "box", size: "md", id: "container-box-#{container.id}") do |box|
  .d
    %span.fw-bold= d(container).display_name
    %code= d(container).short_id
  .d
    = d(container).state_badge
  = box.with_buttons do
    -# START BUTTON
    - if :starting == container.state.status
      = v.button label: t("containers.action.start"),
        icon: "spinner", disabled: true
    - elsif [:exited, :created, :paused].include?(container.state.status)
      = v.update_button label: t("containers.action.start"),
        data: {"stream-ready-target" => "button"},
        icon: "play-fill", url: container_path(container.id),
        params: {command: "start"}, disabled: disabled
    - else
      = v.button label: t("containers.action.start"),
        icon: "play-fill", disabled: true

    -# STOP BUTTON
    - if :stopping == container.state.status
      = v.button label: t("containers.action.stop"),
        icon: "spinner", disabled: true
    - elsif :running == container.state.status
      = v.update_button label: t("containers.action.stop"),
        icon: "stop-fill", url: container_path(container.id),
        data: {"stream-ready-target" => "button"},
        params: {command: "stop"}, disabled: disabled
    - else
      = v.button label: t("containers.action.stop"),
        icon: "stop-fill", disabled: true

    -# RESTART BUTTON
    - if :restarting == container.state.status
      = v.button label: t("containers.action.restart"),
        icon: "spinner", disabled: true
    - elsif :running == container.state.status
      = v.update_button label: t("containers.action.restart"),
        icon: "arrow-clockwise", url: container_path(container.id),
        data: {"stream-ready-target" => "button"},
        params: {command: "restart"}, disabled: disabled
    - else
      = v.button label: t("containers.action.restart"),
        icon: "arrow-clockwise", disabled: true

    -# DESTROY BUTTON
    = v.delete_button label: t("containers.action.destroy"),
      icon: "trash", url: container_path(container.id),
      confirm: t("containers.action.destroy_confirm"),
      disabled: container.state.status != :exited

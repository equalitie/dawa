.card.mb-3
  .card-header= t(".network")
  .card-body
    - if @container.network_settings.networks&.any?
      - @container.network_settings.networks.each do |name, net|
        %h5= name
        %table.table.table-sm.mb-2
          %tbody
            %tr
              %th= t(".ip_address")
              %td= net.ip_address
            %tr
              %th= t(".ip_prefix_len")
              %td= net.ip_prefix_len
            %tr
              %th= t(".gateway")
              %td= net.gateway
            %tr
              %th= t(".mac_address")
              %td= net.mac_address
            %tr
              %th= t(".network_id")
              %td
                %code= net.network_id
    - if (ports = @container.network_settings[:ports])&.any?
      %h5.mt-4= t(".port_mappings")
      %table.table.table-sm.mb-0
        %thead
          %tr
            %th= t(".container_port")
            %th= t(".host_port")
        %tbody
          - ports.each do |container_port, bindings|
            - Array(bindings).flatten.compact.each do |b|
              %tr
                %td= container_port
                %td
                  - host_ip = b.is_a?(Hash) ? b["HostIp"] : b&.host_ip
                  - host_port = b.is_a?(Hash) ? b["HostPort"] : b&.host_port
                  = host_ip.to_s + ":" + host_port.to_s

.card.mb-3
  .card-header= t(".overview")
  .card-body
    %table.table.table-sm.mb-0
      %tbody
        - if @container.state.started_at
          %tr
            %th.text-nowrap= t(".started")
            %td= time_tag Time.parse(@container.state.started_at)
        - if @container.state.finished_at
          %tr
            %th.text-nowrap= t(".finished")
            %td= time_tag Time.parse(@container.state.finished_at)
        %tr
          %th.text-nowrap= t(".image")
          %td= @container.image
        %tr
          %th.text-nowrap= t(".platform")
          %td= @container.platform
        %tr
          %th.text-nowrap= t(".created")
          %td= time_tag @container.created
        %tr
          %th.text-nowrap= t(".restart_count")
          %td= @container.restart_count
        - if @cpu_stats
          %tr
            %th.text-nowrap= t(".cpu")
            %td
              - if @cpu_stats.online_cpus && @cpu_stats.system_cpu_usage && @cpu_stats.cpu_usage&.total_usage
                - cpu_pct = ([@cpu_stats.cpu_usage.total_usage.to_f / @cpu_stats.system_cpu_usage * @cpu_stats.online_cpus * 100, 0].max).round(1)
                = number_to_percentage(cpu_pct, precision: 1)
              - else
                = @cpu_stats.cpu_usage&.total_usage
        - if @memory_stats
          %tr
            %th.text-nowrap= t(".memory")
            %td
              - if @memory_stats.usage && @memory_stats.limit && @memory_stats.limit > 0
                .d-flex.align-items-center.gap-2
                  .progress.flex-grow-1{style: "height: 8px;"}
                    - mem_pct = (@memory_stats.usage.to_f / @memory_stats.limit * 100).round(1)
                    .progress-bar{role: "progressbar", style: "width: #{mem_pct}%;", aria: {valuenow: mem_pct, valuemin: 0, valuemax: 100}}
                  %small.text-muted.text-nowrap= "#{number_to_human_size(@memory_stats.usage)} / #{number_to_human_size(@memory_stats.limit)}"
              - elsif @memory_stats.usage
                = number_to_human_size(@memory_stats.usage)
        - if @container.size_rw
          %tr
            %th.text-nowrap= t(".size_rw")
            %td= number_to_human_size(@container.size_rw)
        - if @container.size_root_fs
          %tr
            %th.text-nowrap= t(".size_root_fs")
            %td= number_to_human_size(@container.size_root_fs)
        %tr
          %th.text-nowrap= t(".driver")
          %td= @container.driver
        %tr
          %th.text-nowrap= t(".hostname_path")
          %td
            %code= @container.hostname_path
        %tr
          %th.text-nowrap= t(".hosts_path")
          %td
            %code= @container.hosts_path
        %tr
          %th.text-nowrap= t(".resolv_conf_path")
          %td
            %code= @container.resolv_conf_path
        %tr
          %th.text-nowrap= t(".log_path")
          %td
            %code= @container.log_path

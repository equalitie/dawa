%div{data: {
    controller: "metrics",
    "metrics-url-value": data_metrics_path(format: :json, window: local_assigns[:window] || params[:window] || "day"),
    "metrics-interval-value": @metrics_poll_interval_ms
  }}
  - @metrics_charts.each do |(key, spec)|
    .chart.mb-3{data: {"metrics-target": "chart", "chart-key": key, "chart-spec": spec.to_json}}
      .chart-body{data: {"chart-body": true}, style: "width: 100%; height: 200px;"}

= breadcrumbs

.btn-toolbar.mb-3
  = v.link_button label: tt(".new.title"), icon: "plus-lg", url: new_oauth_application_path

= v.table do |t|
  - t.column(label: tt(".app_name"))
  - t.column(label: tt(".redirect_uri"))
  - t.column(label: tt(".scopes"))
  - @applications.each do |app|
    - t.with_row do |r|
      - r.with_cell do
        = t.link_to app.name, edit_oauth_application_path(app)
      - r.with_cell do
        = t.link_to app.redirect_uri, edit_oauth_application_path(app)
      - r.with_cell do
        - if app.scopes.present?
          = app.scopes.to_a.map { |s| content_tag(:span, s, class: "badge text-bg-light me-1") }.join.html_safe

= breadcrumbs do |bc|
  - bc.with_crumb { link_to(@application.name, edit_oauth_application_path(@application)) }

= v.box(icon: "key", size: "md") do |box|
  .fw-bold= @application.name
  .d
    = t("nav.created")
    = datetime @application.created_at
    &bull;
    = t("nav.updated")
    = datetime @application.updated_at

= v.tab_bar do |tabs|
  - tabs.with_tab(label: tt(".server_config"), url: edit_oauth_application_path(@application), active: params[:tab].nil?) do
    = render "form", application: @application
  - tabs.with_tab(label: tt(".client_config"), url: edit_oauth_application_path(@application, tab: "client"), active: params[:tab] == "client") do
    = render "client_config", application: @application

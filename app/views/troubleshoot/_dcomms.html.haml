-# dcommsctl: reachable, plus how many jobs it is tracking. `job/list` is the only probe that
-# is both non-mutating and needs no prior knowledge (see the controller).
- if @dcomms_diagnostic[:connected]
  = v.alert("success", icon: "check-circle") do
    .mb-2.fw-bold= t("troubleshoot.connected")
    %ul.list-group.p-0
      %li.list-group-item
        %code= Conf.dcomms_url
      %li.list-group-item.d-flex.justify-content-between.align-items-center
        %span= t("troubleshoot.job_count")
        %span.badge.text-bg-secondary= @dcomms_diagnostic[:job_count]
- else
  = v.alert("danger", icon: "x-circle") do
    .mb-2.fw-bold= t("troubleshoot.unreachable")
    %ul.list-group.p-0
      %li.list-group-item
        %code= Conf.dcomms_url
      %li.list-group-item
        - if @dcomms_diagnostic[:error].present?
          = @dcomms_diagnostic[:error]
        - else
          = t("troubleshoot.error_unknown")

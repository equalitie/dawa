- if @vm_diagnostic[:connected]
  = v.alert("success", icon: "check-circle") do
    .mb-2.fw-bold= t("troubleshoot.connected")
    %ul.list-group.p-0
      %li.list-group-item
        %code= Conf.metrics_url
  - if @vm_diagnostic[:providers].any?
    = v.alert("success", icon: "check-circle") do
      .mb-2.fw-bold= t("metrics.providers")
      %ul.list-group.p-0
        - @vm_diagnostic[:providers].each do |provider|
          %li.list-group-item.d-flex.justify-content-between.align-items-center
            %span
              %code= provider[:instance]
              -# if provider[:job].present?
                %span.text-muted.ms-2= provider[:job]
            - if provider[:up]
              %span.badge.text-bg-success= t("troubleshoot.up")
            - else
              %span.badge.text-bg-danger= t("troubleshoot.down")
  - else
    = v.alert(color: "danger", icon: "x-circle") do
      .mb-2.fw-bold= t("metrics.providers")
      = t("nav.none")
- else
  = v.alert("danger", icon: "x-circle") do
    .mb-2.fw-bold= t("troubleshoot.unreachable")
    %ul.list-group.p-0
      %li.list-group-item
        %code= Conf.metrics_url
      %li.list-group-item
        - if @vm_diagnostic[:error].present?
          = @vm_diagnostic[:error]
        - else
          = t("troubleshoot.error_unknown")

-# VictoriaLogs: reachable, plus how many fields it reports (an empty answer still means the
-# API works, but it is worth showing, since a LogsQL store with no fields has no logs).
- if @vl_diagnostic[:connected]
  = v.alert("success", icon: "check-circle") do
    .mb-2.fw-bold= t("troubleshoot.connected")
    %ul.list-group.p-0
      %li.list-group-item
        %code= Conf.logs_url
      %li.list-group-item.d-flex.justify-content-between.align-items-center
        %span= t("troubleshoot.field_count")
        - if @vl_diagnostic[:field_count].positive?
          %span.badge.text-bg-success= @vl_diagnostic[:field_count]
        - else
          %span.badge.text-bg-warning= t("troubleshoot.field_count_none")
- else
  = v.alert("danger", icon: "x-circle") do
    .mb-2.fw-bold= t("troubleshoot.unreachable")
    %ul.list-group.p-0
      %li.list-group-item
        %code= Conf.logs_url
      %li.list-group-item
        - if @vl_diagnostic[:error].present?
          = @vl_diagnostic[:error]
        - else
          = t("troubleshoot.error_unknown")

.mb-4
  %p= markdown t("enroll.step_credentials.passkey_intro")

.mb-4
  = v.controller("webauthn") do |c|
    = bootstrap_form_with(model: @user, url: enroll_path) do |f|
      = hidden_field_tag :step, "credential"
      .middlebox.bg-light.rounded.p-5
        = add_passkey_button(@credential, c)
        = passkey_added_button(@credential, c)
      .btn-toolbar.mt-4
        = f.v.link_button(label: t("nav.prev"), icon: "chevron-left", url: step_enroll_path(step: "name"))
        - if @credential&.registered?
          = f.v.submit_button(label: t("nav.finish"), icon: "chevron-right")
        - else
          = f.v.submit_button(label: t("nav.finish"), icon: "chevron-right", disabled: true, data: c.target("hide_on_success"))
          = f.v.submit_button(label: t("nav.finish"), icon: "chevron-right", disabled: false, hide: true, data: c.target("show_on_success"))

.mb-4.local-scroll= render "auth/help/passkeys"
